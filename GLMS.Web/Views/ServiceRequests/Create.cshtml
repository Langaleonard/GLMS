@model GLMS.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";
}

<h1 class="page-title">Create Service Request</h1>

<div class="card shadow-soft">
    <div class="card-header">
        Service Request Details
    </div>

    <div class="card-body">
        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ContractId" class="form-label"></label>

                <select asp-for="ContractId"
                        class="form-select"
                        asp-items="ViewBag.ContractId">
                    <option value="">-- Select Contract --</option>
                </select>

                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Enter logistics service request details"></textarea>

                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CostUsd" class="form-label">Cost in USD</label>

                <input asp-for="CostUsd"
                       class="form-control"
                       placeholder="e.g. 2500" />

                <span asp-validation-for="CostUsd" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ExchangeRate" class="form-label">Exchange Rate (Auto Calculated)</label>

                <input asp-for="ExchangeRate"
                       class="form-control"
                       readonly />

                <span asp-validation-for="ExchangeRate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CostZar" class="form-label">Cost in ZAR (Auto Calculated)</label>

                <input asp-for="CostZar"
                       class="form-control"
                       readonly />

                <span asp-validation-for="CostZar" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>

                <select asp-for="Status"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<GLMS.Web.Models.Enums.ServiceRequestStatus>()">
                    <option value="">-- Select Status --</option>
                </select>

                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    Create Service Request
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Back to List
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}