@model GLMS.Web.Models.Contract

@{
    ViewData["Title"] = "Edit Contract";
}

<h1 class="page-title">Edit Contract</h1>

<div class="card shadow-soft">
    <div class="card-header">
        Contract Details
    </div>

    <div class="card-body">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SignedAgreementPath" />

            <div class="mb-3">
                <label asp-for="ClientId" class="form-label"></label>

                <select asp-for="ClientId"
                        class="form-select"
                        asp-items="ViewBag.ClientId">
                    <option value="">-- Select Client --</option>
                </select>

                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label"></label>

                <input asp-for="StartDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label"></label>

                <input asp-for="EndDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>

                <select asp-for="Status"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<GLMS.Web.Models.Enums.ContractStatus>()">
                    <option value="">-- Select Status --</option>
                </select>

                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ServiceLevel" class="form-label"></label>

                <input asp-for="ServiceLevel"
                       class="form-control"
                       placeholder="e.g. Standard, Premium, Express" />

                <span asp-validation-for="ServiceLevel" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
            {
                <div class="mb-3">
                    <label class="form-label">Current Signed Agreement</label>
                    <br />

                    <a href="@Model.SignedAgreementPath"
                       target="_blank"
                       class="btn btn-primary">
                        View Current PDF
                    </a>
                </div>
            }

            <div class="mb-3">
                <label asp-for="SignedAgreementFile" class="form-label">
                    Upload New Signed Agreement PDF
                </label>

                <input asp-for="SignedAgreementFile"
                       type="file"
                       class="form-control"
                       accept=".pdf" />

                <small class="text-muted">
                    Leave this empty if you do not want to replace the existing PDF.
                </small>

                <span asp-validation-for="SignedAgreementFile" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}